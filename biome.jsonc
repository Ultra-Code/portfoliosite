{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "ignore": []
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "all": true,
      "suspicious": {
        "noReactSpecificProps": "off"
      },
      "style": { "noDefaultExport": "off" },
      "correctness": { "useImportExtensions": "off" },
      "nursery": {
        "all": true,
        "useSortedClasses": "off",
        "useExplicitType": "off",
        "useImportRestrictions": "off",
        "useComponentExportOnlyModules": "off"
      }
    }
  },
  "javascript": {
    "globals": ["React"],
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
